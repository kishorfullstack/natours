{
	"name": "natours",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"scss-w": "sass --watch sass/main.scss css/style.css",
		"devserver": "live-server",
		"start": "run-p scss-w devserver",
		"scss": "sass sass/main.scss css/style.comp.css",
		"css-p": "postcss --use autoprefixer -b 'last 10 versions' css/style.comp.css -o css/style.prefix.css",
		"css": "sass css/style.prefix.css css/style.css --style=compressed --no-source-map",
		"build": "npm-run-all scss css-p css"
	},
	"author": "Kishor Kumar",
	"license": "ISC",
	"devDependencies": {
		"autoprefixer": "^10.3.5",
		"npm-run-all": "^4.1.5",
		"postcss-cli": "^8.3.1",
		"sass": "^1.77.0"
	}
}
